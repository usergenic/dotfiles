alias ip='grep -o "[0-9]\+\\.[0-9]\+\\.[0-9]\+\\.[0-9]\+"'
alias big10="find . -type f -print0 | xargs -0 du -h | sort -hr | head -n 10"
alias big100="find . -type f -print0 | xargs -0 du -h | sort -hr | head -n 100"

load_env() {
  local env_file="${1:-.env}"
  if [ -f "$env_file" ]; then
    # 1. set -a: automatically export all variables
    set -a
    # 2. source the file, but use a subshell to filter out comments/empty lines
    source <(grep -v '^#' "$env_file" | sed -E 's/^[[:space:]]*//; s/[[:space:]]*$//')
    set +a
    echo "Successfully loaded $env_file"
  else
    echo "Error: $env_file not found."
    return 1
  fi
}

